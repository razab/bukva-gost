{
  "name": "bukvy-po-gost-checks",
  "private": true,
  "version": "0.0.0",
  "description": "Local test tools; the offline application has no npm runtime dependencies.",
  "scripts": {
    "package:internal": "node scripts/internal-package.mjs",
    "test": "node scripts/test.mjs quick",
    "test:quick": "node scripts/test.mjs quick",
    "test:medium": "node scripts/test.mjs medium",
    "test:full": "node scripts/test.mjs full",
    "test:list": "node scripts/test.mjs --list",
    "spec": "node scripts/openspec.mjs",
    "spec:check": "node scripts/openspec.mjs validate --all --strict --no-interactive"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "c8": "12.0.0"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  }
}
